# ─────────────────────────────────────────────────────────────────────────────
# Hostel Management Multi-Agent System — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here  # backend only — keep secret

# ── LLM APIs ─────────────────────────────────────────────────────────────────
# Gemini (menu PDF parsing) — get free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (complaint classification + inventory NLP) — free at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ── Camera Kiosk Auth ─────────────────────────────────────────────────────────
# Any random secret string — the local kiosk sends this in X-API-Key header
KIOSK_API_KEY=change_this_to_a_random_secret

# ── Face Recognition ─────────────────────────────────────────────────────────
# Cosine similarity threshold for face matching (0.0–1.0); tune during testing
FACE_SIMILARITY_THRESHOLD=0.55

# ── App Settings ─────────────────────────────────────────────────────────────
APP_ENV=development   # development | production
